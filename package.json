{
  "name": "cic-ai-config-helper",
  "version": "1.0.0",
  "description": "AI 编码工具配置助手 — 交互式配置 Claude Code / Cursor / Continue 等 AI 编码工具",
  "type": "module",
  "bin": {
    "cic-ai-config-helper": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --dts --outDir dist --minify",
    "dev": "tsup src/index.ts --format esm --watch --outDir dist",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "ai",
    "config",
    "claude-code",
    "cursor",
    "coding-helper",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecustcic/cic-ai-config-helper"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
